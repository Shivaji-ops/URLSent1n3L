# Copy this file to .env and fill in your Neon connection string
#
# Get it from: neon.tech → your project → Connection Details
# It looks like:
#   postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: IP reputation for URL + IP analysis (free key at abuseipdb.com/register)
# Without it, IP risk uses ip-api.com proxy / hosting data only.
ABUSEIPDB_API_KEY=
